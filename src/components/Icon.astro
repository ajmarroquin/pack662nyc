---
/**
 * Small decorative marks for section headings.
 *
 * Drawn here rather than pulled from an icon library: it keeps the set small
 * and consistent, adds no dependency, and ships inline so there is no request
 * and no flash of missing icon. Always aria-hidden, because the heading next
 * to it already says what the section is.
 */
type Name =
  | 'calendar'
  | 'compass'
  | 'tent'
  | 'book'
  | 'mail'
  | 'people'
  | 'question'
  | 'star'
  | 'pack';

interface Props {
  name: Name;
}

const { name } = Astro.props;

// 24x24 grid, 2px stroke, round caps. Consistent weight matters more than detail.
const paths: Record<Name, string> = {
  calendar:
    'M7 3v3M17 3v3M3.5 9.5h17M5 6h14a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 19 20H5a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 5 6Z',
  compass: 'M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5ZM15.5 8.5l-2 5-5 2 2-5 5-2Z',
  tent: 'M2.5 20h19M12 4.5 4.75 20h14.5L12 4.5Zm0 6L9 20h6l-3-9.5Z',
  book: 'M4 4.5h5a3 3 0 0 1 3 3v12a2.5 2.5 0 0 0-2.5-2.5H4v-12Zm16 0h-5a3 3 0 0 0-3 3v12a2.5 2.5 0 0 1 2.5-2.5H20v-12Z',
  mail: 'M3.5 6.5h17v11h-17v-11Zm0 .5 8.5 6 8.5-6',
  people:
    'M9 11a3.25 3.25 0 1 0 0-6.5A3.25 3.25 0 0 0 9 11Zm-6 8.5a6 6 0 0 1 12 0M16.5 11.25a2.75 2.75 0 1 0 0-5.5M17 14.5a5.5 5.5 0 0 1 4 5',
  question: 'M9 9a3 3 0 1 1 3.75 2.9c-.55.15-.75.6-.75 1.1v1M12 17.25h.01',
  star: 'm12 3.5 2.6 5.65 6.15.75-4.55 4.2 1.2 6.1L12 17.2l-5.4 3 1.2-6.1-4.55-4.2 6.15-.75L12 3.5Z',
  // A backpack, for the gear and uniform section.
  pack: 'M9 6V5a3 3 0 0 1 6 0v1M6.5 6h11A2.5 2.5 0 0 1 20 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-9A2.5 2.5 0 0 1 6.5 6Zm2 5h7v4h-7v-4Z',
};
---

<svg
  class="sec-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
