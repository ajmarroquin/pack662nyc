---
/**
 * The hero illustration.
 *
 * Drawn here rather than sourced, for three reasons that all matter on this
 * particular site:
 *
 * 1. No youth photographs. An image committed to a public repository is
 *    published permanently, and every stock or borrowed Scouting photo is a
 *    picture of somebody's child.
 * 2. No rights question. Nothing here belongs to another unit or a stock library.
 * 3. Inline SVG costs one HTTP request of zero, scales to any screen, and
 *    recolours itself from the same CSS custom properties as the rest of the
 *    site.
 *
 * Decorative, so it is aria-hidden: the heading beside it carries the meaning.
 */
---

<svg
  class="hero-scene"
  viewBox="0 0 800 260"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <!-- Starts at the hero's own cream so the scene grows out of the page
           rather than sitting on it as a pasted-in band. -->
      <stop offset="0%" stop-color="#fbf4e8" />
      <stop offset="34%" stop-color="#ffeccb" />
      <stop offset="100%" stop-color="#ffd79a" />
    </linearGradient>
  </defs>

  <rect width="800" height="260" fill="url(#sky)" />

  <!-- Sun, low and warm. -->
  <circle cx="648" cy="150" r="34" fill="#ffc861" />

  <!-- Far ridge. -->
  <path d="M0 176 L96 138 L168 168 L258 122 L352 170 L436 140 L528 176 L620 148 L712 180 L800 152 L800 260 L0 260 Z"
        fill="#8fb6c4" />

  <!-- Middle ridge. -->
  <path d="M0 200 L104 170 L206 202 L300 172 L410 206 L520 178 L628 208 L740 182 L800 200 L800 260 L0 260 Z"
        fill="#5c8f7b" />

  <!-- Treeline. Varied heights so it does not read as a repeating pattern. -->
  <g fill="#3d6b58">
    <path d="M62 214 L78 176 L94 214 Z" />
    <path d="M86 216 L104 168 L122 216 Z" />
    <path d="M114 214 L128 182 L142 214 Z" />
    <path d="M196 214 L212 178 L228 214 Z" />
    <path d="M222 216 L240 170 L258 216 Z" />
    <path d="M330 215 L346 180 L362 215 Z" />
    <path d="M354 217 L372 172 L390 217 Z" />
    <path d="M382 215 L396 184 L410 215 Z" />
    <path d="M556 215 L572 179 L588 215 Z" />
    <path d="M580 217 L598 169 L616 217 Z" />
    <path d="M608 215 L622 183 L636 215 Z" />
    <path d="M690 216 L708 174 L726 216 Z" />
    <path d="M716 214 L730 182 L744 214 Z" />
  </g>

  <!-- Foreground meadow. -->
  <path d="M0 224 L120 214 L280 228 L460 216 L640 230 L800 218 L800 260 L0 260 Z"
        fill="#2f5a49" />

  <!-- Tent, the one piece of human presence. -->
  <g>
    <path d="M436 244 L470 198 L504 244 Z" fill="#e8b04b" />
    <path d="M470 198 L486 244 L470 244 Z" fill="#d49a36" />
    <path d="M470 210 L458 244 L482 244 Z" fill="#2f5a49" />
  </g>

  <!-- Campfire. -->
  <g>
    <path d="M318 244 Q314 230 322 222 Q322 234 330 230 Q336 240 330 244 Z" fill="#f08a3c" />
    <path d="M322 244 Q320 236 326 231 Q326 239 330 244 Z" fill="#ffd166" />
    <rect x="308" y="243" width="34" height="4" rx="2" fill="#4a3526" />
  </g>
</svg>
