---
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import Icon from '../components/Icon.astro';
import { site, isTodo } from '../data/site';

/**
 * Cost, shape of the year, how to visit before committing, what happens next.
 * The numbers are placeholders on purpose: fees change annually and vary by
 * council, and a wrong figure on this page is the one a family remembers.
 */
const beAScoutFilled = !isTodo(site.beAScoutUrl);
---

<BaseLayout
  title="Join"
  description="How to join Cub Scout Pack 662 in New York City: what it costs, what the year looks like, and how to visit before you decide."
>
  <div class="wrap stack">
    <div class="prose">
      <h1>Join Pack 662</h1>
      <p class="lede">
        Visit first, decide after. Nobody signs anything at a first meeting.
      </p>

      <div class="icon-head">
        <Icon name="people" />
        <h2>Who can join</h2>
      </div>
      <p>
        Any child in kindergarten through fifth grade, and their family. You do not
        need any Scouting background, camping experience, or gear.
      </p>

      <div class="icon-head">
        <Icon name="star" />
        <h2>What it costs</h2>
      </div>
      <p>
        Two separate charges, because they go to two different places.
      </p>
      <dl class="facts">
        <dt>Scouting America membership</dt>
        <dd>
          <strong>{site.cost.membership}</strong> for one year. This registers your child
          nationally and renews on the date you joined, not in September.
        </dd>
        <dt>Pack dues</dt>
        <dd>
          <strong>{site.cost.dues}</strong> a year. These are ours, they run from September,
          and we invoice you through Scoutbook once your child is registered.
        </dd>
        <dt>If cost is a barrier</dt>
        <dd><Field value={site.cost.assistance} /></dd>
      </dl>
      <p class="meta">
        Uniform and handbook are separate, and campouts and some events carry their own
        cost. See the <a href="/faq">FAQ</a> for what you can put off buying.
      </p>
      <p class="meta">
        Uniform and handbook are separate. See <a href="/resources">Resources</a> for
        where to get them, and the <a href="/faq">FAQ</a> for what you can put off
        buying.
      </p>

      <div class="icon-head">
        <Icon name="calendar" />
        <h2>What the year looks like</h2>
      </div>
      <p>
        The Scouting year follows the school year. Dens meet through the fall and
        spring, the whole pack comes together less often, and there are outings and
        at least one campout mixed in. Our schedule is on the{' '}
        <a href="/meetings">meetings page</a>.
      </p>

      <div class="icon-head">
        <Icon name="tent" />
        <h2>Visit before you commit</h2>
      </div>
      <p>
        Come to a meeting and see whether your child likes it. Email{' '}
        <a href={`mailto:${site.email.cubmaster}`}>{site.email.cubmaster}</a> with your
        child's grade and we will tell you which meeting to come to and where to find
        the door.
      </p>
      <p>
        <a class="cta" href={`mailto:${site.email.cubmaster}?subject=${encodeURIComponent('Visiting a Pack 662 meeting')}`}>
          Email the Cubmaster
        </a>
      </p>

      <h2>Signing up</h2>
      <p>
        Registration goes through Scouting America directly, on our BeAScout unit
        page. That is the formal path, and it is the one that actually registers
        your child.
      </p>
      {
        beAScoutFilled ? (
          <p>
            <a class="cta cta-secondary" href={site.beAScoutUrl}>
              Our BeAScout unit page
            </a>
          </p>
        ) : (
          <p><Field value={site.beAScoutUrl} block /></p>
        )
      }

      <h2>What happens after you register</h2>
      </div>
      <ol>
        <li>
          <strong>Register with Scouting America.</strong> A one-year membership,
          {site.cost.membership}, which renews on the date you joined.
          {
            !isTodo(site.registrationUrl) && (
              <> <a href={site.registrationUrl}>Start the registration</a>.</>
            )
          }
        </li>
        <li>
          <strong>Pay pack dues.</strong> {site.cost.dues} a year, running from September.
          We invoice you through Scoutbook once your child is registered.
        </li>
        <li>
          <strong>Get a uniform.</strong> From the
          <a href="/resources">Scout Shop</a>, or from our uniform exchange bins at a
          meeting, which is free and worth checking first.
        </li>
        <li>
          <strong>Fill out the health form.</strong> Parts A and B of the Annual Health
          and Medical Record, on the <a href="/resources">Resources</a> page. We do not
          need an insurance card, a doctor's signature or a vaccination record; just
          what is on the form.
        </li>
      </ol>
      <p>
        Your child joins the den for their grade, and that den leader will be in touch
        with the den's schedule. Any adult who plans to volunteer also takes Scouting
        America's Youth Protection training, which is free, online, and takes under an
        hour.
      </p>

      <div class="prose">
      <p>
        Questions before any of that: <a href={`mailto:${site.email.info}`}>{site.email.info}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
