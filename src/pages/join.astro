---
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import { site, isTodo } from '../data/site';

/**
 * Cost, shape of the year, how to visit before committing, what happens next.
 * The numbers are placeholders on purpose: fees change annually and vary by
 * council, and a wrong figure on this page is the one a family remembers.
 */
const beAScoutFilled = !isTodo(site.beAScoutUrl);
---

<BaseLayout
  title="Join"
  description="How to join Cub Scout Pack 662 in New York City: what it costs, what the year looks like, and how to visit before you decide."
>
  <div class="wrap stack">
    <div class="prose">
      <h1>Join Pack 662</h1>
      <p class="lede">
        Visit first, decide after. Nobody signs anything at a first meeting.
      </p>

      <h2>Who can join</h2>
      <p>
        Any child in kindergarten through fifth grade, and their family. You do not
        need any Scouting background, camping experience, or gear.
      </p>

      <h2>What it costs</h2>
      <dl class="facts">
        <dt>Per Scout, per year</dt>
        <dd><Field value={site.cost.amount} /></dd>
        <dt>What that covers</dt>
        <dd><Field value={site.cost.covers} /></dd>
        <dt>If cost is a barrier</dt>
        <dd><Field value={site.cost.assistance} /></dd>
      </dl>
      <p class="meta">
        Uniform and handbook are separate. See <a href="/resources">Resources</a> for
        where to get them, and the <a href="/faq">FAQ</a> for what you can put off
        buying.
      </p>

      <h2>What the year looks like</h2>
      <p>
        The Scouting year follows the school year. Dens meet through the fall and
        spring, the whole pack comes together less often, and there are outings and
        at least one campout mixed in. Our schedule is on the{' '}
        <a href="/meetings">meetings page</a>.
      </p>

      <h2>Visit before you commit</h2>
      <p>
        Come to a meeting and see whether your child likes it. Email{' '}
        <a href={`mailto:${site.email.cubmaster}`}>{site.email.cubmaster}</a> with your
        child's grade and we will tell you which meeting to come to and where to find
        the door.
      </p>
      <p>
        <a class="cta" href={`mailto:${site.email.cubmaster}?subject=${encodeURIComponent('Visiting a Pack 662 meeting')}`}>
          Email the Cubmaster
        </a>
      </p>

      <h2>Signing up</h2>
      <p>
        Registration goes through Scouting America directly, on our BeAScout unit
        page. That is the formal path, and it is the one that actually registers
        your child.
      </p>
      {
        beAScoutFilled ? (
          <p>
            <a class="cta cta-secondary" href={site.beAScoutUrl}>
              Our BeAScout unit page
            </a>
          </p>
        ) : (
          <p><Field value={site.beAScoutUrl} block /></p>
        )
      }

      <h2>What happens after you register</h2>
      <ol>
        <li>You get an invitation to Scoutbook, where advancement and calendar live.</li>
        <li>Your child is placed in the den for their grade, and that den leader is in touch.</li>
        <li>
          You fill out parts A and B of the Scouting America Annual Health Record.
          It is on the <a href="/resources">Resources</a> page and is needed before
          any overnight.
        </li>
        <li>
          Any adult who plans to volunteer takes Youth Protection training. It is
          free, online, and takes under an hour.
        </li>
      </ol>

      <p>
        Questions before any of that: <a href={`mailto:${site.email.info}`}>{site.email.info}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
