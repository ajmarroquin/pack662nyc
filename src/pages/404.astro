---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist on the Cub Scout Pack 662 site."
>
  <div class="wrap prose">
    <h1>That page does not exist</h1>
    <p class="lede">
      The link may be old, or there may be a typo in the address.
    </p>
    <p>Most people arriving here are looking for one of these:</p>
    <ul>
      <li><a href="/join">How to join the pack</a></li>
      <li><a href="/meetings">When and where we meet</a></li>
      <li><a href="/resources">Parent resources, forms, and sign-in</a></li>
      <li><a href="/contact">Contact us</a></li>
    </ul>
    <p><a class="cta" href="/">Back to the home page</a></p>
  </div>
</BaseLayout>
