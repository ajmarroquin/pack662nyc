---
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import { site, isTodo } from '../data/site';

/**
 * A mailto:, deliberately, not a form. A form means a backend to run, spam to
 * filter, and messages that quietly go nowhere when a volunteer stops checking
 * an inbox. Mail to the pack's shared mailbox lands somewhere four people
 * already look.
 *
 * One address rather than three, so the subject line does the sorting. Each
 * link below pre-fills one, which costs the sender nothing and gives whoever
 * opens the inbox something to triage on.
 *
 * This site stores nothing and never will. Anything that takes a submission
 * belongs in the separate member tool, not in this public repository.
 */
const m = site.meeting;

/** Pre-fills the subject so a shared inbox can be sorted at a glance. */
const mailto = (subject: string) =>
  `mailto:${site.email.pack}?subject=${encodeURIComponent(subject)}`;

const reasons = [
  {
    who: 'Visiting or joining',
    subject: 'Visiting a Pack 662 meeting',
    when: 'Tell us your child\u2019s grade and we will say which meeting to come to and where to find the door.',
  },
  {
    who: 'Cost, dues or financial assistance',
    subject: 'Pack 662 dues and cost',
    when: 'Including if the cost is a problem for your family. That conversation is handled quietly.',
  },
  {
    who: 'Volunteering',
    subject: 'Volunteering with Pack 662',
    when: 'Most of what is needed is small: driving, bringing something, running one activity.',
  },
  {
    who: 'Anything else',
    subject: 'Pack 662',
    when: 'If none of the above fits, this is the one to use.',
  },
];
---

<BaseLayout
  title="Contact"
  description="How to reach Cub Scout Pack 662 in New York City, and where we meet."
>
  <div class="wrap stack">
    <div class="prose">
      <h1>Contact</h1>
      <p class="lede">
        One address, read by four of us, so nothing waits on any one person
        being free.
      </p>
      <p>
        <a class="cta" href={mailto('Pack 662')}>{site.email.pack}</a>
      </p>
      <p class="meta">
        Pick the closest match below and we will get it to the right person. It
        goes to the Cubmasters, the Committee Chair and our Council Unit
        Representative.
      </p>
    </div>

    {
      reasons.map((r) => (
        <section class="card">
          <h2>{r.who}</h2>
          <p class="meta">{r.when}</p>
          <p>
            <a href={mailto(r.subject)}>Email us about this</a>
          </p>
        </section>
      ))
    }

    {
      /*
        A second route that does not depend on the pack's own mailbox at all,
        because Scouting America runs it. Worth keeping for the same reason a
        building has two exits.
      */
      !isTodo(site.beAScoutUrl) && (
        <section class="card">
          <h2>Or ask through BeAScout</h2>
          <p>
            Our unit page on Scouting America's own site has a{' '}
            <strong>Request More Information</strong> button that sends your question
            straight to us.
          </p>
          <p>
            <a class="cta cta-secondary" href={site.beAScoutUrl}>
              Our BeAScout unit page
            </a>
          </p>
        </section>
      )
    }

    <section class="card">
      <h2>Where we meet</h2>
      <address class="meta" style="font-style: normal;">
        <Field value={m.locationName} /><br />
        <Field value={m.streetAddress} /><br />
        <Field value={m.addressLocality} />, {m.addressRegion} <Field value={m.postalCode} />
      </address>
      <p><a href="/meetings">Schedule and how to find the entrance &rarr;</a></p>
    </section>

    <div class="prose">
      <p class="meta">
        We do not have a contact form. Mail goes to people, not a database; this
        site collects nothing and stores nothing about you.
      </p>
    </div>
  </div>
</BaseLayout>
